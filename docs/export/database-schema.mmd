    USERS ||--o{ SHOPS : owns
    SHOPS ||--o{ SHOP_MEMBERS : has
    USERS ||--o{ SHOP_MEMBERS : joins
    PRODUCT_CATEGORIES o|--o{ PRODUCT_CATEGORIES : parent_of
    PRODUCT_CATEGORIES ||--o{ MASTER_PRODUCTS : classifies
    USERS ||--o{ PRODUCT_SUGGESTIONS : suggests
    USERS o|--o{ PRODUCT_SUGGESTIONS : reviews
    USERS ||--o{ COLLECTIONS : owns
    PRODUCT_CATEGORIES o|--o{ COLLECTIONS : scopes
    COLLECTIONS ||--o{ COLLECTION_ITEMS : contains
    MASTER_PRODUCTS ||--o{ COLLECTION_ITEMS : identifies
    SHOPS ||--o{ SHOP_PRODUCTS : stocks
    MASTER_PRODUCTS ||--o{ SHOP_PRODUCTS : identifies
    USERS ||--o{ RESERVATIONS : places
    SHOPS ||--o{ RESERVATIONS : receives
