# Valores locales de ejemplo. Copiar a infra/.env y cambiar fuera de local.
POSTGRES_DB=collectohub
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=collectohub
POSTGRES_PASSWORD=collectohub_local_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200

JWT_SECRET=local-development-jwt-secret-change-before-production
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

SHOP_DEFAULT_CURRENCY=EUR
SHOP_DEFAULT_RESERVATION_EXPIRATION_HOURS=48

FILES_STORAGE_PATH=./uploads
